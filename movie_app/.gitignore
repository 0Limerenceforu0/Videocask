# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
.edge_cdp/
.edge_profile/
.edge_profile2/
%SystemDrive%/

# 启动脚本（不要被 build/ 兜底忽略）
!/build/release/
!/build/release/*.bat
!/build/release/*.md

