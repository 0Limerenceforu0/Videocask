# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
.edge_cdp/
.edge_profile/
.edge_profile2/
%SystemDrive%/

# 启动脚本（不要被 build/ 兜底忽略）
!/build/release/
!/build/release/*.bat
!/build/release/*.md

# CDP 调试截图（诊断产物，不入库）
tool/*.png

# media_kit build hook 的原生库缓存（由 tool/seed_media_kit_native_cache.py 生成）
native-cache/

# 一次性排障产物
tool/webverify/
tool/__pycache__/

# 发版产物（APK/ZIP 由 tool/package_deliverables.py 生成本地，不入库）
/deliverables/

# 一次性死代码备份
/_dead_code_backup_20260929/

# 发版凭证（GitHub PAT），绝不入库；模板见 .env.example
.env
