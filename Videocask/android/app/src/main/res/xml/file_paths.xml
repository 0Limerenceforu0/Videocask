<?xml version="1.0" encoding="utf-8"?>
<!--
  FileProvider 可共享的路径白名单（应用内更新用）。

  更新包由 path_provider 的 getTemporaryDirectory() 下载，在 Android 上
  就是 context.getCacheDir()，所以主路径是 <cache-path>。
  另外两条是兜底：部分机型 path_provider 会回落到 external-cache。
  只暴露 videocask_updates 子目录，不要把整个 cache 交出去。
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path name="videocask_updates" path="videocask_updates/" />
    <external-cache-path name="videocask_updates_external" path="videocask_updates/" />
    <external-files-path name="videocask_files" path="." />
</paths>
